{
  "name": "mi-note-x10-android",
  "private": true,
  "version": "0.76.0",
  "type": "module",
  "description": "Mi Note X10: aplicación Android Capacitor con BLE Huion modo agenda, cuadernos locales y respaldo privado",
  "scripts": {
    "prepare:android": "node scripts/prepare.mjs",
    "build:web": "node scripts/prepare.mjs && node scripts/features.mjs && vite build",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.3.4",
    "@capacitor/android": "8.3.4",
    "@capacitor-community/bluetooth-le": "8.3.0",
    "jszip": "3.10.1",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.4",
    "vite": "7.1.12"
  }
}
