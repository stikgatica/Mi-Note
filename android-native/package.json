{
  "name": "mi-note-x10-android",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Mi Note X10: app Android con Bluetooth LE nativo basada en la interfaz V0.2",
  "scripts": {
    "prepare:android": "node scripts/prepare.mjs",
    "build:web": "node scripts/prepare.mjs && vite build",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.3.4",
    "@capacitor/android": "8.3.4",
    "@capacitor-community/bluetooth-le": "8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.4",
    "vite": "7.1.12"
  }
}
